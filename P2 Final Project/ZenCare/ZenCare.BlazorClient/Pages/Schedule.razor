@page "/schedule"
@inject HttpClient Http
@using ZenCare.BlazorClient.Models
@using System.Net.Http.Json

<PageTitle>ZenCare – Weekly Schedule</PageTitle>

<h3 class="mb-4">
    <i class="bi bi-calendar-week me-2" style="color:var(--zen-primary)"></i>
    Weekly Schedule
</h3>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label">Specialist</label>
        <select class="form-select" @bind="_specialistId"
                @bind:after="LoadSchedule">
            <option value="">Select a specialist…</option>
            @foreach (var s in _specialists)
            {
                <option value="@s.Id">@s.FullName</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Week starting</label>
        <input type="date" class="form-control"
               @bind="_weekStart" @bind:format="yyyy-MM-dd"
               @bind:after="LoadSchedule" />
    </div>
</div>

@if (_loading)
{
    <div class="text-center py-4">
        <div class="spinner-border" style="color:var(--zen-primary)"></div>
    </div>
}
else if (_appts.Any())
{
    @foreach (var day in ByDay)
    {
        <div class="zen-card card mb-3">
            <div class="zen-card-header">
                <i class="bi bi-calendar-day me-2"></i>
                @day.Key.ToString("dddd, MMMM dd yyyy")
                <span class="badge bg-light text-dark ms-2">
                    @day.Value.Count appointments
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table zen-table mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Therapy</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in day.Value)
                        {
                            <tr>
                                <td>
                                    <strong>@a.ScheduledAt.ToString("HH:mm")</strong>
                                </td>
                                <td>@a.PatientName</td>
                                <td>@a.TherapyName</td>
                                <td>@a.TherapyDuration min</td>
                                <td>
                                    <span class="badge @Badge(a.StatusName)">
                                        @a.StatusName
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
else if (_specialistId != Guid.Empty)
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-calendar-x" style="font-size:3rem"></i>
        <p class="mt-3">No appointments found for this week.</p>
    </div>
}

@code {
    private List<AppointmentModel> _appts = new();
    private List<SpecialistModel> _specialists = new();
    private Guid _specialistId = Guid.Empty;
    private DateTime _weekStart = DateTime.Today;
    private bool _loading = false;

    protected override async Task OnInitializedAsync()
    {
        _specialists = await Http.GetFromJsonAsync<List<SpecialistModel>>(
            "api/specialists") ?? new();

        int diff = (7 + ((int)DateTime.Today.DayOfWeek - (int)DayOfWeek.Monday)) % 7;
        _weekStart = DateTime.Today.AddDays(-diff);
    }

    private async Task LoadSchedule()
    {
        if (_specialistId == Guid.Empty) return;
        _loading = true;
        var end = _weekStart.AddDays(6);
        _appts = await Http.GetFromJsonAsync<List<AppointmentModel>>(
            $"api/specialists/{_specialistId}/schedule" +
            $"?start={_weekStart:yyyy-MM-dd}&end={end:yyyy-MM-dd}") ?? new();
        _loading = false;
    }

    private Dictionary<DateTime, List<AppointmentModel>> ByDay =>
        _appts
            .GroupBy(a => a.ScheduledAt.Date)
            .OrderBy(g => g.Key)
            .ToDictionary(
                g => g.Key,
                g => g.OrderBy(a => a.ScheduledAt).ToList());

    private static string Badge(string s) => s switch
    {
        "Pending" => "badge-pending",
        "Confirmed" => "badge-confirmed",
        "Completed" => "badge-completed",
        "Cancelled" => "badge-cancelled",
        _ => "bg-secondary"
    };
}